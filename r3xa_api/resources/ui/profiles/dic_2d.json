{
  "id": "dic_2d",
  "title": "Tensile test with 2D DIC",
  "description": "A prefilled tensile-test workflow linking the camera to images, DIC and displacement fields, and the testing machine to its data files.",
  "recommended_kinds": [
    "settings/specimen",
    "data_sources/generic",
    "data_sources/camera",
    "data_sources/dic_measurement",
    "data_sets/file",
    "data_sets/list"
  ],
  "links": [
    {
      "from_step": "machine",
      "to_step": "machine_data",
      "to_field": "parent_data_sources",
      "to_many": true
    },
    {
      "from_step": "camera",
      "to_step": "images",
      "to_field": "parent_data_sources",
      "to_many": true
    },
    {
      "from_step": "images",
      "to_step": "dic",
      "to_field": "input_data_sets",
      "to_many": true
    },
    {
      "from_step": "dic",
      "to_step": "displacement_fields",
      "to_field": "parent_data_sources",
      "to_many": true
    }
  ],
