          "required": true
        },
        {
          "field": "description",
          "title": "Describe the machine and the measured channels.",
          "required": true
        },
        {
          "field": "manufacturer",
          "title": "Who manufactured the machine?"
        },
        {
          "field": "model",
          "title": "What is the machine model?"
        }
      ]
