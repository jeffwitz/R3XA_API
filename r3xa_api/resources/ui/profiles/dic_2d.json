{
  "id": "dic_2d",
  "title": "2D Digital Image Correlation",
  "description": "Describe a mechanical experiment measured with one visible camera and DIC.",
  "recommended_kinds": [
    "settings/specimen",
    "settings/testing_machine",
    "data_sources/camera",
    "data_sources/dic_measurement",
    "data_sets/file"
  ],
  "steps": [
    {
      "id": "experiment",
      "title": "Experiment",
