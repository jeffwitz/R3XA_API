      "id": "experiment",
      "title": "Experiment",
      "section": "header",
      "defaults": {
        "title": "Tensile test with 2D DIC",
        "description": "Prefilled example of a tensile experiment measured with a visible camera and a testing machine.",
        "authors": [
          {
            "name": "R3XA Team"
          }
        ],
        "date": "2026-09-01"
      },
      "questions": [
        {
          "field": "title",
          "title": "What is the name of the experiment?",
          "required": true
        },
        {
          "field": "authors",
          "title": "Who performed the experiment?"
        },
        {
          "field": "date",
          "title": "When was the experiment performed?"
        }
      ]
    },
    {
      "id": "specimen",
      "title": "Specimen",
      "section": "settings",
      "kind": "settings/specimen",
      "defaults": {
        "title": "Tensile specimen",
        "description": "Flat specimen prepared for a tensile test with a speckle pattern for 2D DIC.",
        "sizes": [
          {
            "kind": "unit",
            "title": "gauge length",
            "value": 50.0,
            "unit": "mm",
            "scale": 1.0
          },
          {
            "kind": "unit",
            "title": "width",
            "value": 12.5,
            "unit": "mm",
            "scale": 1.0
          },
          {
            "kind": "unit",
            "title": "thickness",
            "value": 1.0,
            "unit": "mm",
            "scale": 1.0
          }
        ],
        "patterning_technique": "White paint with black speckles"
      },
      "questions": [
        {
          "field": "title",
          "title": "What specimen was tested?",
          "required": true
        },
        {
          "field": "description",
          "title": "Describe the specimen.",
          "required": true
        },
        {
          "field": "sizes",
          "title": "What are the specimen dimensions?"
        },
        {
          "field": "patterning_technique",
          "title": "How was the specimen patterned?"
        }
      ]
    },
