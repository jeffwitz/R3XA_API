        "manufacturer": "Not specified",
        "model": "Not specified"
      },
      "questions": [
        {"field": "title", "title": "Which process produced the displacement field?", "required": true},
        {"field": "description", "title": "Describe the FE-DIC processing.", "required": true},
        {"field": "output_units", "title": "Which displacement units were used?", "required": true},
        {"field": "manufacturer", "title": "Who developed the process?", "required": true},
        {"field": "model", "title": "What is its version?", "required": true}
      ]
    },
