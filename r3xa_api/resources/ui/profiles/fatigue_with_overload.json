      "title": "Overload images",
      "section": "data_sets",
      "kind": "data_sets/list",
      "defaults": {
        "title": "Overload images",
        "description": "Image sequence recorded during the overload test.",
        "path": "images/",
        "file_type": "image/tiff",
        "time_reference": {"kind": "unit", "title": "reference time", "value": 0.0, "unit": "s", "scale": 1.0},
        "timestamps": [0.0],
        "data": ["ovl1_0000.tif"]
      },
      "questions": [
        {"field": "title", "title": "How should the image data be named?", "required": true},
        {"field": "description", "title": "Describe the image sequence.", "required": true},
        {"field": "path", "title": "Where are the images stored?"},
        {"field": "file_type", "title": "What type of image files are they?", "required": true}
      ]
    },
    {
