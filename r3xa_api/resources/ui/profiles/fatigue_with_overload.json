      "title": "SIF data file",
      "section": "data_sets",
      "kind": "data_sets/file",
      "defaults": {
        "title": "SIF data",
        "description": "Final file containing the stress-intensity-factor results for the overload.",
        "folder": "data/",
        "time_reference": 0.0,
        "timestamps": {"kind": "data_set_file", "filename": "sif.csv", "file_type": "text/csv", "delimiter": ","},
        "data": {"kind": "data_set_file", "filename": "sif.csv", "file_type": "text/csv", "delimiter": ","}
      },
      "questions": [
        {"field": "title", "title": "How should the SIF file be named?", "required": true},
        {"field": "description", "title": "Describe the SIF data.", "required": true},
