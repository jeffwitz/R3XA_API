        "time_reference": 0.0,
        "timestamps": {"kind": "data_set_file", "filename": "load.csv", "file_type": "text/csv", "delimiter": ","},
        "data": {"kind": "data_set_file", "filename": "load.csv", "file_type": "text/csv", "delimiter": ","}
      },
      "questions": [
        {"field": "title", "title": "How should the load file be named?", "required": true},
        {"field": "description", "title": "Describe the load data.", "required": true},
