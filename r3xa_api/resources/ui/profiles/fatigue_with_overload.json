      "title": "SIF extractor",
      "section": "data_sources",
      "kind": "data_sources/generic",
      "defaults": {
        "title": "SIF extractor",
        "description": "Software extracting stress-intensity-factor information from the test data.",
        "output_components": 1,
        "output_dimension": "curve",
        "output_units": [{"kind": "unit", "title": "stress intensity factor", "unit": "MPa*m^0.5", "scale": 1.0}],
        "manufacturer": "Not specified",
        "model": "Not specified"
      },
      "questions": [
        {"field": "title", "title": "Which software extracted the SIF?", "required": true},
        {"field": "description", "title": "Describe the SIF extraction.", "required": true},
