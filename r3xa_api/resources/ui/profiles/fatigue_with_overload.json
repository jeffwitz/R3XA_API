      "title": "FE-DIC source",
      "section": "data_sources",
      "kind": "data_sources/generic",
      "defaults": {
        "title": "FE-DIC",
        "description": "Finite-element digital image correlation processing of the camera images.",
        "output_components": 2,
        "output_dimension": "surface",
        "output_units": [
          {"kind": "unit", "title": "horizontal displacement", "unit": "mm", "scale": 1.0},
