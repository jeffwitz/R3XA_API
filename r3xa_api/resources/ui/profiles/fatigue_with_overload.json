{
  "id": "fatigue_with_overload",
  "title": "Fatigue test with overload",
  "description": "A prefilled workflow linking camera images and machine data to DIC and SIF results.",
  "recommended_kinds": [
    "settings/specimen",
    "data_sources/camera",
    "data_sources/generic",
    "data_sets/list",
    "data_sets/file",
    "data_sets/generic"
  ],
  "links": [
    {"from_step": "camera", "to_step": "images", "to_field": "data_sources", "to_many": true},
    {"from_step": "images", "to_step": "fe_dic", "to_field": "input_data_sets", "to_many": true},
    {"from_step": "load_sensor", "to_step": "load_data", "to_field": "data_sources", "to_many": true},
    {"from_step": "sif_extractor", "to_step": "sif_data", "to_field": "data_sources", "to_many": true},
    {"from_step": "fe_dic", "to_step": "displacement", "to_field": "data_sources", "to_many": true}
  ],
  "steps": [
    {
      "id": "experiment",
      "title": "Experiment",
      "section": "header",
      "defaults": {
        "title": "Fatigue test with overload",
        "description": "Prefilled example with camera images, machine measurements, SIF extraction, and FE-DIC.",
        "authors": "R3XA Team",
        "date": "2026-09-01"
      },
      "questions": [
        {"field": "title", "title": "What is the name of the experiment?", "required": true},
        {"field": "description", "title": "How would you describe the experiment?", "required": true},
        {"field": "authors", "title": "Who performed the experiment?"},
        {"field": "date", "title": "When was it performed?"}
      ]
    },
    {
      "id": "specimen",
      "title": "Specimen",
      "section": "settings",
      "kind": "settings/specimen",
      "defaults": {
        "title": "SENT specimen",
        "description": "Single-edge notched tensile specimen used for the fatigue test.",
        "sizes": [{"kind": "unit", "title": "width", "value": 30.0, "unit": "mm", "scale": 1.0}],
        "patterning_technique": "White paint with black speckles"
      },
      "questions": [
        {"field": "title", "title": "What specimen was tested?", "required": true},
        {"field": "description", "title": "Describe the specimen.", "required": true},
        {"field": "sizes", "title": "What are the specimen dimensions?", "required": true},
        {"field": "patterning_technique", "title": "How was the specimen patterned?"}
      ]
    },
    {
      "id": "camera",
      "title": "Camera",
      "section": "data_sources",
      "kind": "data_sources/camera",
      "defaults": {
        "title": "Visible camera",
        "description": "Camera recording images during the fatigue test.",
        "output_components": 1,
        "output_dimension": "surface",
        "output_units": [{"kind": "unit", "title": "graylevel", "unit": "gl", "scale": 1.0}],
        "manufacturer": "Vieworks",
        "model": "High-speed camera",
        "image_size": [
          {"kind": "unit", "title": "width", "value": 2048, "unit": "px", "scale": 1.0},
          {"kind": "unit", "title": "height", "value": 2048, "unit": "px", "scale": 1.0}
        ]
      },
      "questions": [
        {"field": "title", "title": "Which camera recorded the images?", "required": true},
        {"field": "description", "title": "Describe the camera."},
        {"field": "manufacturer", "title": "Who manufactured the camera?"},
        {"field": "model", "title": "What is the camera model?"},
        {"field": "image_size", "title": "What is the image resolution?", "required": true}
      ]
    },
    {
      "id": "load_sensor",
      "title": "Load sensor",
      "section": "data_sources",
      "kind": "data_sources/generic",
      "defaults": {
        "title": "Load sensor",
        "description": "Force measurement from the fatigue testing machine.",
        "output_components": 1,
        "output_dimension": "point",
        "output_units": [{"kind": "unit", "title": "force", "unit": "N", "scale": 1.0}],
        "manufacturer": "Not specified",
        "model": "Not specified"
      },
      "questions": [
        {"field": "title", "title": "Which source measured the load?", "required": true},
        {"field": "description", "title": "Describe the load measurement.", "required": true},
        {"field": "output_units", "title": "Which load units were used?", "required": true},
        {"field": "manufacturer", "title": "Who manufactured the source?", "required": true},
        {"field": "model", "title": "What is its model?", "required": true}
      ]
    },
    {
