{
  "id": "in_situ_tensile",
  "title": "In-situ tensile test",
  "description": "A prefilled in-situ tensile workflow linking the testing machine and camera acquisitions to their measured results.",
  "recommended_kinds": [
    "settings/specimen",
    "data_sources/generic",
    "data_sources/camera",
    "data_sources/dic_measurement",
    "data_sets/list",
    "data_sets/file"
  ],
  "links": [
    {"from_step": "machine", "to_step": "machine_data", "to_field": "parent_data_sources", "to_many": true},
    {"from_step": "camera", "to_step": "images", "to_field": "parent_data_sources", "to_many": true},
    {"from_step": "images", "to_step": "dic", "to_field": "input_data_sets", "to_many": true},
    {"from_step": "dic", "to_step": "displacement_fields", "to_field": "parent_data_sources", "to_many": true}
  ],
  "steps": [
    {
      "id": "experiment",
      "title": "Experiment",
      "section": "header",
      "defaults": {
        "title": "In-situ tensile test",
        "description": "Prefilled example combining tensile loading, camera acquisition, and 2D DIC measurement.",
        "authors": ["R3XA Team"],
        "date": "2026-09-01"
      },
      "questions": [
        {"field": "title", "title": "What is the name of the experiment?", "required": true},
        {"field": "description", "title": "How would you describe the experiment?", "required": true},
        {"field": "authors", "title": "Who performed the experiment?"},
        {"field": "date", "title": "When was it performed?"}
      ]
    },
    {
      "id": "specimen",
      "title": "Specimen",
      "section": "settings",
      "kind": "settings/specimen",
      "defaults": {
        "title": "In-situ tensile specimen",
        "description": "Flat specimen prepared for tensile loading and optical measurement.",
        "sizes": [
          {"kind": "unit", "title": "gauge length", "value": 50.0, "unit": "mm", "scale": 1.0},
          {"kind": "unit", "title": "width", "value": 12.5, "unit": "mm", "scale": 1.0},
          {"kind": "unit", "title": "thickness", "value": 1.0, "unit": "mm", "scale": 1.0}
        ],
        "patterning_technique": "White paint with black speckles"
      },
      "questions": [
        {"field": "title", "title": "What specimen was tested?", "required": true},
        {"field": "description", "title": "Describe the specimen.", "required": true},
        {"field": "sizes", "title": "What are the specimen dimensions?", "required": true},
        {"field": "patterning_technique", "title": "How was the specimen patterned?"}
      ]
    },
    {
      "id": "machine",
      "title": "Testing machine",
      "section": "data_sources",
      "kind": "data_sources/generic",
      "defaults": {
        "title": "Universal testing machine",
        "description": "In-situ testing machine recording force and displacement during tensile loading.",
        "output_components": 2,
        "output_dimension": "curve",
        "output_units": [
          {"kind": "unit", "title": "force", "unit": "N", "scale": 1.0},
          {"kind": "unit", "title": "displacement", "unit": "mm", "scale": 1.0}
        ],
        "manufacturer": "Instron",
        "model": "5800"
      },
      "questions": [
        {"field": "title", "title": "Which machine applied the tensile load?", "required": true},
        {"field": "description", "title": "Describe the machine and its channels.", "required": true},
        {"field": "manufacturer", "title": "Who manufactured the machine?", "required": true},
        {"field": "model", "title": "What is the machine model?", "required": true}
      ]
    },
    {
      "id": "camera",
      "title": "Camera",
      "section": "data_sources",
      "kind": "data_sources/camera",
      "defaults": {
        "title": "Visible camera",
        "description": "Camera recording the specimen during in-situ tensile loading.",
        "output_components": 1,
        "output_dimension": "surface",
        "output_units": [{"kind": "unit", "title": "graylevel", "unit": "gl", "scale": 1.0}],
        "manufacturer": "Allied Vision Technologies (AVT)",
        "model": "Dolphin F-145B",
        "image_size": [
          {"kind": "unit", "title": "width", "value": 1392, "unit": "px", "scale": 1.0},
          {"kind": "unit", "title": "height", "value": 1040, "unit": "px", "scale": 1.0}
        ]
      },
      "questions": [
        {"field": "title", "title": "Which camera recorded the specimen?", "required": true},
        {"field": "description", "title": "Describe the camera."},
        {"field": "manufacturer", "title": "Who manufactured the camera?"},
        {"field": "model", "title": "What is the camera model?"},
        {"field": "image_size", "title": "What is the image resolution?", "required": true}
      ]
    },
    {
      "id": "machine_data",
      "title": "Machine data",
      "section": "data_sets",
      "kind": "data_sets/file",
      "defaults": {
        "title": "Force and displacement data",
        "description": "Final CSV file containing force and displacement recorded during tensile loading.",
        "path": "machine/",
        "timestamps": {"kind": "data_set_file", "filename": "machine.csv", "file_type": "text/csv", "delimiter": ","},
        "values": {"kind": "data_set_file", "filename": "machine.csv", "file_type": "text/csv", "delimiter": ","}
      },
      "questions": [
        {"field": "title", "title": "How should the machine data be named?", "required": true},
        {"field": "description", "title": "Describe the machine data.", "required": true},
        {"field": "path", "title": "Where is the machine file stored?"}
      ]
    },
    {
      "id": "images",
      "title": "Camera images",
      "section": "data_sets",
      "kind": "data_sets/list",
      "defaults": {
        "title": "In-situ camera images",
        "description": "Image sequence recorded during tensile loading.",
        "path": "images/",
        "data_type": "image/tiff",
        "time_reference": {"kind": "unit", "title": "reference time", "value": 0.0, "unit": "s", "scale": 1.0},
        "timestamps": [0.0],
        "values": ["image_0000.tif"]
      },
      "questions": [
        {"field": "title", "title": "How should the camera images be named?", "required": true},
        {"field": "description", "title": "Describe the image sequence.", "required": true},
        {"field": "path", "title": "Where are the images stored?"},
        {"field": "data_type", "title": "What type of image files are they?", "required": true}
      ]
    },
    {
      "id": "dic",
      "title": "2D DIC",
      "section": "data_sources",
      "kind": "data_sources/dic_measurement",
      "defaults": {
        "title": "2D DIC processing",
        "description": "Digital image correlation measuring displacement on the specimen surface.",
        "output_components": 2,
        "output_dimension": "surface",
        "output_units": [
          {"kind": "unit", "title": "horizontal displacement", "unit": "mm", "scale": 1.0},
          {"kind": "unit", "title": "vertical displacement", "unit": "mm", "scale": 1.0}
        ],
        "manufacturer": "Not specified",
        "model": "Not specified",
        "matching_criterion": "ZNSSD"
      },
      "questions": [
        {"field": "title", "title": "Which process measured the displacement?", "required": true},
        {"field": "description", "title": "Describe the DIC processing.", "required": true},
        {"field": "output_components", "title": "How many displacement components are produced?", "required": true},
        {"field": "output_dimension", "title": "What is the output dimension?", "required": true},
        {"field": "output_units", "title": "Which units describe the displacement?", "required": true},
        {"field": "manufacturer", "title": "Who developed the DIC software?", "required": true},
        {"field": "model", "title": "What is its version?", "required": true},
        {"field": "matching_criterion", "title": "Which matching criterion was used?", "required": true}
      ]
    },
    {
      "id": "displacement_fields",
      "title": "DIC displacement fields",
      "section": "data_sets",
      "kind": "data_sets/file",
      "defaults": {
        "title": "In-situ DIC displacement fields",
        "description": "Final displacement-field file calculated from the in-situ camera images.",
        "path": "dic/",
        "timestamps": {"kind": "data_set_file", "filename": "timestamps.csv", "file_type": "text/csv", "delimiter": ","},
        "values": {"kind": "data_set_file", "filename": "displacement_fields.h5", "file_type": "application/x-hdf5"}
      },
      "questions": [
        {"field": "title", "title": "How should the DIC result be named?", "required": true},
        {"field": "description", "title": "Describe the DIC displacement fields.", "required": true},
        {"field": "path", "title": "Where are the DIC results stored?"}
      ]
    }
  ]
}
