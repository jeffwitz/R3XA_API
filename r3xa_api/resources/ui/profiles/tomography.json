{
  "id": "tomography",
  "title": "X-ray tomography",
  "description": "A prefilled tomography workflow linking an X-ray tomograph to projections, reconstruction, and a final volume file.",
  "recommended_kinds": [
    "settings/specimen",
    "data_sources/tomograph",
    "data_sources/generic",
    "data_sources/dic_measurement",
    "data_sets/list",
    "data_sets/file"
  ],
  "links": [
    {"from_step": "tomograph", "to_step": "projections", "to_field": "parent_data_sources", "to_many": true},
    {"from_step": "projections", "to_step": "reconstruction", "to_field": "input_data_sets", "to_many": true},
    {"from_step": "reconstruction", "to_step": "volume", "to_field": "parent_data_sources", "to_many": true},
    {"from_step": "volume", "to_step": "dvc", "to_field": "input_data_sets", "to_many": true},
    {"from_step": "dvc", "to_step": "dvc_displacement", "to_field": "parent_data_sources", "to_many": true}
  ],
  "steps": [
    {
      "id": "experiment",
      "title": "Experiment",
      "section": "header",
      "defaults": {
        "title": "X-ray tomography experiment",
        "description": "Prefilled example with X-ray projections, a reconstruction process, and a final volume file.",
        "authors": ["R3XA Team"],
        "date": "2026-09-01"
      },
      "questions": [
        {"field": "title", "title": "What is the name of the experiment?", "required": true},
        {"field": "description", "title": "How would you describe the experiment?", "required": true},
        {"field": "authors", "title": "Who performed the experiment?"},
        {"field": "date", "title": "When was it performed?"}
      ]
    },
    {
      "id": "specimen",
      "title": "Specimen",
      "section": "settings",
      "kind": "settings/specimen",
      "defaults": {
        "title": "Tomography specimen",
        "description": "Specimen scanned with X-ray tomography.",
        "sizes": [{"kind": "unit", "title": "diameter", "value": 10.0, "unit": "mm", "scale": 1.0}]
      },
      "questions": [
        {"field": "title", "title": "What specimen was scanned?", "required": true},
        {"field": "description", "title": "Describe the specimen.", "required": true},
        {"field": "sizes", "title": "What are the specimen dimensions?", "required": true}
      ]
    },
    {
      "id": "tomograph",
      "title": "X-ray tomograph",
      "section": "data_sources",
      "kind": "data_sources/tomograph",
      "defaults": {
        "title": "X-ray tomograph",
        "description": "Tomograph acquiring radiographic projections of the specimen.",
        "output_components": 1,
        "output_dimension": "volume",
        "output_units": [{"kind": "unit", "title": "attenuation", "unit": "1/mm", "scale": 1.0}],
        "image_size": [
          {"kind": "unit", "title": "width", "value": 2048, "unit": "px", "scale": 1.0},
          {"kind": "unit", "title": "height", "value": 2048, "unit": "px", "scale": 1.0}
        ],
        "source": "X-ray tube and flat-panel detector"
      },
      "questions": [
        {"field": "title", "title": "Which tomograph acquired the projections?"},
        {"field": "description", "title": "Describe the tomograph."},
        {"field": "output_components", "title": "How many output components are produced?", "required": true},
        {"field": "output_dimension", "title": "What is the output dimension?", "required": true},
        {"field": "output_units", "title": "Which units describe the output?", "required": true},
        {"field": "image_size", "title": "What is the detector resolution?", "required": true},
        {"field": "source", "title": "What is the X-ray source?", "required": true}
      ]
    },
    {
      "id": "projections",
      "title": "Projection images",
      "section": "data_sets",
      "kind": "data_sets/list",
      "defaults": {
        "title": "Raw X-ray projections",
        "description": "Radiographic projection sequence acquired by the tomograph.",
        "path": "tomography/projections/",
        "data_type": "image/tiff",
        "time_reference": {"kind": "unit", "title": "reference time", "value": 0.0, "unit": "s", "scale": 1.0},
        "timestamps": [0.0],
        "values": ["projection_0000.tif"]
      },
      "questions": [
        {"field": "title", "title": "How should the projection data be named?", "required": true},
        {"field": "description", "title": "Describe the projection sequence.", "required": true},
        {"field": "path", "title": "Where are the projections stored?"},
        {"field": "data_type", "title": "What type of projection files are they?", "required": true}
      ]
    },
    {
      "id": "reconstruction",
      "title": "Reconstruction",
      "section": "data_sources",
      "kind": "data_sources/generic",
      "defaults": {
        "title": "Tomography reconstruction",
        "description": "Reconstruction process converting projections into a three-dimensional volume.",
        "output_components": 1,
        "output_dimension": "volume",
        "output_units": [{"kind": "unit", "title": "voxel intensity", "unit": "a.u.", "scale": 1.0}],
        "manufacturer": "Not specified",
        "model": "Not specified"
      },
      "questions": [
        {"field": "title", "title": "Which process reconstructed the volume?", "required": true},
        {"field": "description", "title": "Describe the reconstruction process.", "required": true},
        {"field": "output_units", "title": "Which units describe the reconstructed volume?", "required": true},
        {"field": "manufacturer", "title": "Who developed the reconstruction software?", "required": true},
        {"field": "model", "title": "What is its version?", "required": true}
      ]
    },
    {
      "id": "volume",
      "title": "Reconstructed volume",
      "section": "data_sets",
      "kind": "data_sets/file",
      "defaults": {
        "title": "Reconstructed volume",
        "description": "Final three-dimensional volume reconstructed from the X-ray projections.",
        "path": "tomography/",
        "timestamps": {"kind": "data_set_file", "filename": "timestamps.csv", "file_type": "text/csv", "delimiter": ","},
        "values": {"kind": "data_set_file", "filename": "reconstructed_volume.h5", "file_type": "application/x-hdf5"}
      },
      "questions": [
        {"field": "title", "title": "How should the reconstructed volume be named?", "required": true},
        {"field": "description", "title": "Describe the reconstructed volume.", "required": true},
        {"field": "path", "title": "Where is the volume stored?"}
      ]
    },
    {
      "id": "dvc",
      "title": "Digital volume correlation",
      "section": "data_sources",
      "kind": "data_sources/dic_measurement",
      "defaults": {
        "title": "Digital volume correlation",
        "description": "DVC processing comparing reconstructed volumes to measure three-dimensional displacement.",
        "output_components": 3,
        "output_dimension": "volume",
        "output_units": [
          {"kind": "unit", "title": "x displacement", "unit": "mm", "scale": 1.0},
          {"kind": "unit", "title": "y displacement", "unit": "mm", "scale": 1.0},
          {"kind": "unit", "title": "z displacement", "unit": "mm", "scale": 1.0}
        ],
        "manufacturer": "Not specified",
        "model": "Not specified",
        "matching_criterion": "ZNSSD"
      },
      "questions": [
        {"field": "title", "title": "Which process measured the 3D displacement?", "required": true},
        {"field": "description", "title": "Describe the DVC processing.", "required": true},
        {"field": "output_components", "title": "How many displacement components are produced?", "required": true},
        {"field": "output_dimension", "title": "What is the output dimension?", "required": true},
        {"field": "output_units", "title": "Which units describe the displacement?", "required": true},
        {"field": "manufacturer", "title": "Who developed the DVC software?", "required": true},
        {"field": "model", "title": "What is its version?", "required": true},
        {"field": "matching_criterion", "title": "Which matching criterion was used?", "required": true}
      ]
    },
    {
      "id": "dvc_displacement",
      "title": "DVC displacement volume",
      "section": "data_sets",
      "kind": "data_sets/file",
      "defaults": {
        "title": "DVC displacement field",
        "description": "Final three-dimensional displacement field calculated from the reconstructed volumes.",
        "path": "tomography/dvc/",
        "timestamps": {"kind": "data_set_file", "filename": "timestamps.csv", "file_type": "text/csv", "delimiter": ","},
        "values": {"kind": "data_set_file", "filename": "dvc_displacement.h5", "file_type": "application/x-hdf5"}
      },
      "questions": [
        {"field": "title", "title": "How should the DVC result be named?", "required": true},
        {"field": "description", "title": "Describe the DVC displacement field.", "required": true},
        {"field": "path", "title": "Where is the DVC result stored?"}
      ]
    }
  ]
}
